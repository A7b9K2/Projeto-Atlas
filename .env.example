# =====================================================================
# Atlas — variáveis de ambiente (copie para .env.local e preencha)
# O preview roda SEM nada disto (DATA_PROVIDER=mock é o padrão).
# =====================================================================

# ----- Camada de dados -----
# mock     → seed em memória, sem chaves (padrão do preview)
# supabase → banco real (requer as chaves abaixo)
DATA_PROVIDER=mock

# ----- Supabase (região South America / São Paulo — requisito LGPD) -----
# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (anon) — segura para o cliente; RLS protege os dados
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de service role — SOMENTE server-side (Edge Functions/onboarding).
# NUNCA expor ao cliente. Usada pela função criar_academia_com_proprietario.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Integrações (stubs no MVP; preencher ao ativar provedores) -----
# Pagamentos (Brasil: Asaas/Pagar.me/Stripe)
PAYMENT_PROVIDER=stub
PAYMENT_API_KEY=

# Comunicação (e-mail/push/WhatsApp)
COMMUNICATION_PROVIDER=stub
COMMUNICATION_API_KEY=

# IA / LLM (provedor abstraído; guardrails de anonimização de menores)
LLM_PROVIDER=stub
LLM_API_KEY=
# Teto de custo por chamada (tokens de saída)
LLM_MAX_TOKENS=512

# ----- Ambiente -----
# development | staging | production
APP_ENV=development
