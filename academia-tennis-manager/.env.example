# Porta do servidor HTTP
PORT=3000

# Segredo usado para assinar os cookies de sessao (OBRIGATORIO em producao).
# Gere um valor aleatorio, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Caminho do arquivo do banco SQLite (opcional).
# Padrao: database/academia.db
DB_PATH=

# Define se os cookies exigem HTTPS. Use "true" em producao.
COOKIE_SECURE=false

# Duracao da sessao padrao, em minutos (sem "Lembrar acesso").
SESSION_TTL_MINUTES=120

# Duracao da sessao com "Lembrar acesso", em minutos (padrao: 30 dias).
SESSION_REMEMBER_TTL_MINUTES=43200
